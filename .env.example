# ---------------------------------------------------------------------------
# TIM backend configuration. Copy to `.env` (never commit `.env`).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Optional: database name if it isn't in the URI.
MONGODB_DB_NAME=tim

# JWT secrets: two DIFFERENT random strings, at least 32 characters each.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Frontend origin(s), comma-separated. Used for CORS and for links in emails.
CLIENT_URL=http://localhost:3000

# Refresh-token cookie. Leave COOKIE_DOMAIN empty unless frontend and API share a parent domain.
# COOKIE_SAMESITE defaults to "none" in production (Vercel <-> Render are cross-site) and "lax" otherwise.
COOKIE_DOMAIN=
# COOKIE_SAMESITE=none

# Number of reverse proxies in front of the API (Render = 1). Needed for correct client IPs and rate limits.
TRUST_PROXY=0

BCRYPT_ROUNDS=12

# --- Email (optional) --------------------------------------------------------
# Without SMTP, password-reset and invite links are printed to the console in development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=TIM <no-reply@example.com>

# --- File storage (optional, S3-compatible) -----------------------------------
# Required for task/project attachments; without it uploads return 503.
# Works with AWS S3, Cloudflare R2, Supabase Storage (S3 API) and MinIO.
STORAGE_BUCKET=
STORAGE_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com   Supabase: https://<project>.supabase.co/storage/v1/s3
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Set if the bucket is public / behind a CDN; otherwise links are 1-hour presigned URLs.
STORAGE_PUBLIC_URL=
# true for MinIO and Supabase.
STORAGE_FORCE_PATH_STYLE=false
MAX_UPLOAD_MB=25

# --- Misc -----------------------------------------------------------------------
# Hourly "deadline approaching" notifications.
ENABLE_JOBS=false
# Log every request in production too (always on in development).
LOG_REQUESTS=false
